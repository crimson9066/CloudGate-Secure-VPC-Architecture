# Terraform Variables Configuration
# Copy this file to terraform.tfvars and customize the values

# Project Configuration
project_name = "cloudgate"
environment  = "dev"

# AWS Region (me-south-1 is Bahrain - closest to Egypt)
aws_region = "me-south-1"

# Network Configuration
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["me-south-1a", "me-south-1b", "me-south-1c"]

# Administration uses AWS Systems Manager Session Manager; public SSH is disabled.
bastion_instance_type = "t3.micro"
assign_eip_to_bastion = false

# Opt-in observability and security services. These can incur AWS charges.
enable_vpc_flow_logs      = false
enable_cloudtrail          = false
enable_security_services   = false
enable_ssm_vpc_endpoints   = false

# Optional demonstration workload.
enable_sample_application = false
enable_sample_database    = false
